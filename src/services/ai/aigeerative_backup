// services/ai/aiGenerateService.ts
import Anthropic from "@anthropic-ai/sdk";
import OpenAI from "openai";
import { 
    AI_MODELS, 
    getModelForDocumentType,
    calculateDraftCost,
    EXCHANGE_RATE 
} from "../../config/ai-cost-config";

// Initialize AI clients
const anthropic = new Anthropic({
    apiKey: process.env.ANTHROPIC_API_KEY,
});

const openai = new OpenAI({
    apiKey: process.env.OPENAI_API_KEY,
});

interface GenerateParams {
    title: string;
    type: string;
    tone: string;
    includeOutline: boolean;
    fileContent: string;
    userId: string;
}

interface GenerateResult {
    content: string;
    outline?: string;
    wordCount: number;
    tokensUsed: {
        input: number;
        output: number;
        total: number;
    };
    modelUsed: string;
    costEstimate: {
        usd: number;
        zar: number;
    };
    generatedAt: string;
}

export const aiGenerateService = async (params: GenerateParams): Promise<GenerateResult> => {
    const { title, type, tone, includeOutline, fileContent, userId } = params;

    // Determine which AI to use based on document type
    const modelName = getModelForDocumentType(type);
    const modelConfig = AI_MODELS.find(m => m.name === modelName);

    if (!modelConfig) {
        throw new Error(`Model ${modelName} not found`);
    }

    let content: string = "";
    let outline: string | undefined;
    let inputTokens: number = 0;
    let outputTokens: number = 0;
    let modelUsed: string = modelName;

    try {
        // Route to appropriate AI service
        if (modelName === 'claude-sonnet-4.6') {
            const result = await generateWithClaude(fileContent, title, type, tone, includeOutline);
            content = result.content;
            outline = result.outline;
            inputTokens = result.inputTokens;
            outputTokens = result.outputTokens;
        } else if (modelName === 'gpt-4o') {
            const result = await generateWithOpenAI(fileContent, title, type, tone);
            content = result.content;
            inputTokens = result.inputTokens;
            outputTokens = result.outputTokens;
        } else if (modelName === 'claude-haiku-4.5') {
            const result = await generateWithHaiku(fileContent, title, type, tone);
            content = result.content;
            inputTokens = result.inputTokens;
            outputTokens = result.outputTokens;
        } else {
            // Fallback to Claude Sonnet
            const result = await generateWithClaude(fileContent, title, type, tone, includeOutline);
            content = result.content;
            outline = result.outline;
            inputTokens = result.inputTokens;
            outputTokens = result.outputTokens;
        }

        // Calculate word count
        const wordCount = content.split(/\s+/).length;

        // Calculate cost
        const cost = calculateDraftCost(modelUsed, inputTokens, outputTokens);

        return {
            content,
            outline,
            wordCount,
            tokensUsed: {
                input: inputTokens,
                output: outputTokens,
                total: inputTokens + outputTokens,
            },
            modelUsed,
            costEstimate: cost,
            generatedAt: new Date().toISOString(),
        };

    } catch (error: any) {
        console.error("AI generation error:", error);
        throw new Error(error.message || "Failed to generate content");
    }
};

// Claude Sonnet Generation (Complex tasks)
const generateWithClaude = async (
    content: string, 
    title: string, 
    type: string, 
    tone: string, 
    includeOutline: boolean
) => {
    const response = await anthropic.messages.create({
        model: "claude-3-5-sonnet-20241022",
        max_tokens: 4000,
        temperature: 0.7,
        system: getClaudeSystemPrompt(tone),
        messages: [
            {
                role: "user",
                content: getClaudeUserPrompt(content, title, type, includeOutline),
            },
        ],
    });

    const result = response.content[0]?.type === "text" ? response.content[0].text : "";
    return {
        content: result,
        outline: extractOutline(result),
        inputTokens: response.usage?.input_tokens || 0,
        outputTokens: response.usage?.output_tokens || 0,
    };
};

// Claude Haiku Generation (Simple tasks)
const generateWithHaiku = async (
    content: string, 
    title: string, 
    type: string, 
    tone: string
) => {
    const response = await anthropic.messages.create({
        model: "claude-3-5-haiku-20241022",
        max_tokens: 1500,
        temperature: 0.5,
        system: getHaikuSystemPrompt(tone),
        messages: [
            {
                role: "user",
                content: getHaikuUserPrompt(content, title, type),
            },
        ],
    });

    const result = response.content[0]?.type === "text" ? response.content[0].text : "";
    return {
        content: result,
        inputTokens: response.usage?.input_tokens || 0,
        outputTokens: response.usage?.output_tokens || 0,
    };
};

// OpenAI Generation (Summaries)
const generateWithOpenAI = async (
    content: string, 
    title: string, 
    type: string, 
    tone: string
) => {
    const response = await openai.chat.completions.create({
        model: "gpt-4o",
        max_tokens: 2000,
        temperature: 0.5,
        messages: [
            {
                role: "system",
                content: getOpenAISystemPrompt(tone),
            },
            {
                role: "user",
                content: getOpenAIUserPrompt(content, title, type),
            },
        ],
    });

    const result = response.choices[0]?.message?.content || "";
    return {
        content: result,
        inputTokens: response.usage?.prompt_tokens || 0,
        outputTokens: response.usage?.completion_tokens || 0,
    };
};

